{
  "name": "nagar-vault-ingestion-service",
  "version": "1.0.0",
  "private": true,
  "description": "NagarVault common ingestion service with presigned MinIO uploads and Kafka event publishing",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
