    "check": "node --check src/server.js && node --check src/app.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "jose": "5.10.0",
    "kafkajs": "2.2.4",
    "minio": "8.0.7",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.1.12"
  }
