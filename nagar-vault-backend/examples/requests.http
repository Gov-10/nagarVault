@api = http://localhost:3000

### Service information
GET {{api}}/

### Health check
GET {{api}}/health

### JSON-only complaint
POST {{api}}/api/v1/events
Content-Type: application/json

{
  "schemaVersion": "1.0",
  "department": "nmc",
  "eventType": "nmc.complaint.created",
  "sourceSystem": "mock-citizen-app",
  "sourceRecordId": "NMC-2026-000124",
  "occurredAt": "2026-08-17T14:32:00+05:30",
  "sensitivity": "restricted",
  "location": { "wardId": "ZONE-5" },
  "payload": {
    "category": "waterlogging",
    "description": "Synthetic complaint without an attachment",
    "status": "open"
  },
  "attachments": []
}

### Request a presigned URL
# Replace size with the exact byte size of your local file.
POST {{api}}/api/v1/uploads/presign
Content-Type: application/json

{
  "department": "nmc",
  "eventType": "nmc.complaint.created",
  "sourceRecordId": "NMC-2026-000125",
  "sensitivity": "restricted",
  "files": [
    {
      "fileName": "waterlogging.jpg",
      "contentType": "image/jpeg",
      "size": 182440
    }
  ]
}
