# Auth / JWT
# Replace with a random 256-bit hex string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-256-bit-hex-string

# PostgreSQL
# Replace with a strong password
POSTGRES_PASSWORD=change-me-to-a-strong-password

# MinIO
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key

# Redis (added for persistent event/upload-intent stores)
REDIS_URL=redis://redis:6379
